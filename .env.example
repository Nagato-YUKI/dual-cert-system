# Flask 安全配置（必填）
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-another-random-string

# 数据库配置（必填，PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/dual_cert_db

# AI 审核 API 配置（可选，未配置则使用模拟审核）
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# AI 聊天机器人 API 配置（可选，推荐智谱AI GLM-4-Flash 永久免费）
# 注册地址：https://open.bigmodel.cn/  新用户送2000万Token
CHAT_API_KEY=
CHAT_API_BASE=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4-flash
